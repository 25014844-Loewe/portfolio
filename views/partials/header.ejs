      <radialGradient id="sakura-heart" cx="38%" cy="30%"><stop stop-color="#ef8ba6"/><stop offset=".65" stop-color="#d94f78"/><stop offset="1" stop-color="#a92e5c"/></radialGradient>
      <filter id="sakura-soft-shadow" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur in="SourceAlpha" stdDeviation=".65"/><feOffset dy=".45"/><feComponentTransfer><feFuncA type="linear" slope=".35"/></feComponentTransfer><feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      <g id="sakura-one-petal"><path d="M16 17.3C12.9 14.6 8.5 10.5 9.7 6.3c.7-2.5 2.9-4.2 5.2-4.2 2.5 0 4.7 1.8 5.3 4.3 1.1 4.1-3.1 8.8-4.2 10.9Z" fill="url(#sakura-petal)" stroke="#fff0f2" stroke-width=".45"/><path d="M16 16.5c-.2-3.1-.1-7.2-1.4-11.1M15.7 12.4l-3.1-3.1m3.4 5.1 3-3.5" fill="none" stroke="#c96e88" stroke-opacity=".52" stroke-width=".36" stroke-linecap="round"/><path d="M11.1 6.1c.8-1.4 1.8-2 3-2.3" fill="none" stroke="#fff" stroke-opacity=".8" stroke-width=".55" stroke-linecap="round"/></g>
    </defs>
    <g filter="url(#sakura-soft-shadow)"><use href="#sakura-one-petal"/><use href="#sakura-one-petal" transform="rotate(72 16 16)"/><use href="#sakura-one-petal" transform="rotate(144 16 16)"/><use href="#sakura-one-petal" transform="rotate(216 16 16)"/><use href="#sakura-one-petal" transform="rotate(288 16 16)"/></g>
    <g fill="none" stroke="#fff9ec" stroke-width=".42" stroke-linecap="round"><path d="M16 16 12.2 9.1M16 16 14.8 7.8M16 16 17.4 7.8M16 16 19.8 9.2M16 16 21 12.2M16 16 11 12.2M16 16 12.8 18.2M16 16 19.2 18.2"/></g>
    <g fill="#d9a24e" stroke="#fff0c8" stroke-width=".22"><circle cx="12.2" cy="9.1" r=".72"/><circle cx="14.8" cy="7.8" r=".68"/><circle cx="17.4" cy="7.8" r=".68"/><circle cx="19.8" cy="9.2" r=".72"/><circle cx="21" cy="12.2" r=".66"/><circle cx="11" cy="12.2" r=".66"/><circle cx="12.8" cy="18.2" r=".62"/><circle cx="19.2" cy="18.2" r=".62"/></g>
    <circle cx="16" cy="16" r="2.05" fill="url(#sakura-heart)" stroke="#ffd5df" stroke-width=".45"/><circle cx="15.25" cy="15.3" r=".48" fill="#ffdce5" opacity=".8"/></svg>
  </div>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Loewe Sing home"><span class="wordmark-logo-wrap"><img class="wordmark-logo" src="/images/sakura-logo.png" alt=""></span><span>LOEWE SING</span></a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" class="<%= activePage === 'home' ? 'is-active' : '' %>">Home</a>
      <a href="/about" class="<%= activePage === 'about' ? 'is-active' : '' %>">About</a>
      <a href="/projects" class="<%= activePage === 'projects' ? 'is-active' : '' %>">Projects</a>
      <a href="/contact" class="<%= activePage === 'contact' ? 'is-active' : '' %>">Contact</a>
    </nav>
  </header>
