<%- include('partials/header', { title: 'Contact — Loewe Sing', bodyClass: 'contact-page', activePage: 'contact' }) %>

<main id="main" class="contact-main">
  <section class="contact-intro">
    <p class="section-kicker">LET'S CONNECT</p>
    <h1>Good things <em>start here.</em></h1>
    <p>Have a project, opportunity, or just want to say hello? I’d love to hear from you.</p>
  </section>

  <section class="contact-layout content-width" aria-label="Contact Loewe Sing">
    <div class="contact-direct">
      <p class="contact-column-kicker">DIRECT CONTACT</p>
      <div class="contact-info-card">
        <span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></span>
        <span><small>Email</small><strong>25014844@myrp.edu.sg</strong></span><span class="contact-card-arrow" aria-hidden="true">↗</span><button class="contact-copy" type="button" data-copy="25014844@myrp.edu.sg" aria-label="Copy email address">⧉</button>
      </div>
      <div class="contact-info-card">
        <span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h3l2 5-2.2 1.7a15 15 0 0 0 4.5 4.5L16 12l5 2v3c0 1.1-.9 2-2 2C10.7 19 5 13.3 5 6c0-1.7.7-3 2-3Z"/></svg></span>
        <span><small>Phone</small><strong>89400118</strong></span><span class="contact-card-arrow" aria-hidden="true">↗</span><button class="contact-copy" type="button" data-copy="89400118" aria-label="Copy phone number">⧉</button>
      </div>
      <a class="contact-info-card" href="https://www.linkedin.com/in/loewe-sing-1a16a3365" target="_blank" rel="noopener noreferrer">
        <span class="contact-icon contact-icon-in" aria-hidden="true">in</span>
        <span><small>LinkedIn</small><strong>linkedin.com/in/loewe-sing-1a16a3365</strong></span><span class="contact-card-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="contact-action-link" href="mailto:25014844@myrp.edu.sg">Email me directly <span aria-hidden="true">↗</span></a>
    </div>

    <form class="contact-form <%= sent ? 'is-sent' : '' %>" action="/contact" method="post">
      <p class="contact-column-kicker">SEND A MESSAGE</p>
      <% if (sent) { %><div class="contact-confirmation" role="status"><span aria-hidden="true">✿</span><h2>Message sent into the breeze.</h2><p>This site doesn’t send or store messages yet; please email me directly to make sure your message reaches me.</p><button type="button" class="contact-again">Send another message</button></div><% } %>
      <% if (error) { %><p class="contact-feedback contact-feedback-error" role="alert">Please complete every field and enter a valid email address.</p><% } %>
      <div class="contact-form-row">
        <label>Full Name<input type="text" name="name" autocomplete="name" placeholder="Your name" required></label>
        <label>Email Address<input type="email" name="email" autocomplete="email" placeholder="you@example.com" required></label>
      </div>
      <label>Subject<input type="text" name="subject" placeholder="What would you like to talk about?" required></label>
      <label>Message<textarea name="message" rows="6" placeholder="Write your message here…" required></textarea></label>
      <button class="contact-submit" type="submit">Send message <span aria-hidden="true">↗</span></button>
    </form>
  </section>

</main>

<%- include('partials/footer') %>
